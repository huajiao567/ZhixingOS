# 知行镜后端环境变量
# 复制为 .env 并填入真实值

# 服务端口
PORT=3001

# ───────────────────────────────────────────────
# 密钥安全（P0-6 / P0-8）
# 下方 DEEPSEEK_API_KEY 原为明文示例密钥，已被公开泄露。
# ⚠️ 必须到 DeepSeek 控制台（platform.deepseek.com）「API Keys」处
#    吊销旧密钥并生成新密钥后填入此处。轮换后旧密钥立即失效，
#    即使它曾出现在 git 历史中也不可再用。
# 切勿把真实密钥提交进 git（.env 已在 .gitignore 中忽略）。
# ───────────────────────────────────────────────
DEEPSEEK_API_KEY=

# JWT：访问令牌短周期 15m；刷新令牌 7d（不透明随机串，可撤销）
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
# 生产环境 JWT_SECRET 务必换成 32 位以上随机串（例如 `openssl rand -hex 32`）
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX

# DeepSeek API（OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# LLM 省钱策略：是否启用响应缓存
LLM_CACHE_ENABLED=true

# CORS 允许来源（逗号分隔；生产请设为你的 App 域名，不要用 *）
CORS_ORIGIN=http://localhost:8081

# 数据库文件路径
DB_PATH=./data/zhixing.db

# ───────────────────────────────────────────────
# 邮件发送（V4.3 §10 路线图 A26，Task 27.6）
# EMAIL_PROVIDER=dev → console.log 输出邮件内容（默认非生产环境，不实际发送）
# EMAIL_PROVIDER=nodemailer → 通过 SMTP 发送（生产环境，nodemailer 需在生产环境安装）
# ───────────────────────────────────────────────
EMAIL_PROVIDER=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@zhixingos.com
# App 前端 base URL，用于生成密码重置链接（生产环境替换为实际域名）
APP_BASE_URL=http://localhost:8081

# 自动备份；生产环境建议保持 true 并将备份目录放在加密卷
BACKUP_ENABLED=true
